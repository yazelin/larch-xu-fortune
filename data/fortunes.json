    "reading": "「{char}」拆作「{parts}」。形中有相依之處；你問的事，先理清彼此的牽連，再走下一步。",
    "fallback": "「{char}」依你所選，屬「{radical}」部，共{strokes}畫。部首是提綱，筆畫是次第；先把眼前的一步寫穩，後面的路才接得起來。",
    "fallbackNote": "表外字的部首、總筆畫由你提供；本攤不猜拆法。此為借形解意的通用解語。"
  },
  "bird": {
    "title": "鳥卦",
    "subtitle": "讓小鳥替你捎一封信",
    "intro": "可報上稱呼，把問題留在心裡。待小鳥走過卦箋，叼來一張，再親手展開。",
    "note": "依鳥取卦箋的流程改編。卦箋為本作新寫，不冒用廟宇籤詩。",
    "slips": [
      {
        "id": "bird-01",
        "title": "初晴",
        "text": "雲開一線，先把窗推開；等候的消息，也許正需要你先問一聲。"
      },
      {
        "id": "bird-02",
        "title": "舊友",
        "text": "舊路仍通，故人未遠；重提一段往事，便有新的話可說。"
      },
      {
        "id": "bird-03",
        "title": "緩行",
        "text": "路長不怕慢，怕的是忘了歇息；今日把腳步放輕一些。"
      },
      {
        "id": "bird-04",
        "title": "新枝",
        "text": "枝頭才見新芽，不必急著問果實；先替心願留一點空間。"
      },
      {
        "id": "bird-05",
        "title": "歸帆",
        "text": "遠帆漸近，莫只顧張望；把手邊的事備好，便能從容相迎。"
      },
      {
        "id": "bird-06",
        "title": "問路",
        "text": "路口有人，何妨開口；一句請教，勝過獨自繞行。"
      },
      {
        "id": "bird-07",
        "title": "守信",
        "text": "允人的話，記在心上；小小的信約，會替你搭一座橋。"
      },
      {
        "id": "bird-08",
        "title": "留白",
        "text": "紙上留白，話也留餘地；此時不說盡，日後更好相見。"
      },
      {
        "id": "bird-09",
        "title": "同行",
        "text": "獨行有獨行的快，同行有同行的穩；找一位願意商量的人。"
      },
      {
        "id": "bird-10",
        "title": "添燈",
        "text": "燈不嫌小，照得見腳前便好；先做一件辦得到的事。"
      },
      {
        "id": "bird-11",
        "title": "知止",
        "text": "走到水邊，先看深淺；能停一步，也是一種本領。"
      },
      {
        "id": "bird-12",
        "title": "修補",
        "text": "舊衣尚可補，舊約尚可談；別急著把有用的全數換掉。"
      },
      {
        "id": "bird-13",
        "title": "借風",
        "text": "風來時揚帆，風歇時理繩；時機之外，還有準備。"
      },
      {
        "id": "bird-14",
        "title": "聽雨",
        "text": "雨聲再密，也有間歇；忙亂之中，替自己留一刻安靜。"
      },
      {
        "id": "bird-15",
        "title": "解結",
        "text": "結愈扯愈緊，鬆一鬆才看得清；換個問法，再談一次。"
      },
      {
        "id": "bird-16",
        "title": "種豆",
        "text": "一粒一粒種下，一日一日照料；你要的長久，從規律開始。"
      },
      {
        "id": "bird-17",
        "title": "照水",
        "text": "水靜才照得清；先分清旁人的期待與自己的願望。"
      },
      {
        "id": "bird-18",
        "title": "回音",
        "text": "說出去的心意，未必立刻有答覆；給彼此一點時間。"
      },
      {
        "id": "bird-19",
        "title": "啟程",
        "text": "行囊不必滿，方向要明白；少帶一分掛慮，多帶一分準備。"
      },
      {
        "id": "bird-20",
        "title": "小滿",
        "text": "已有所得，也仍有餘地；珍惜眼前，莫忙著與人比量。"
      },
      {
        "id": "bird-21",
        "title": "轉角",
        "text": "熟路未必只有一條；換個時辰出門，也會看見新的風景。"
      },
      {
        "id": "bird-22",
        "title": "相讓",
        "text": "爭先未必先到，相讓未必吃虧；先聽對方把話說完。"
      },
      {
        "id": "bird-23",
        "title": "拾穗",
        "text": "大事之外，小事也能養人；今日收好一份微小的進展。"
      },
      {
        "id": "bird-24",
        "title": "候潮",
        "text": "水有進退，人有張弛；暫時退一步，好讓力氣回來。"
      },
      {
        "id": "bird-25",
        "title": "開卷",
        "text": "疑問不妨查書，也不妨請教；答案需要的，也許是一項新知。"
      },
      {
        "id": "bird-26",
        "title": "惜時",
        "text": "想見的人，想說的話，挑一件今日便做；不必全等明日。"
      },
      {
        "id": "bird-27",
        "title": "理線",
        "text": "線頭雖多，一次理一條；先把最要緊的事排在前面。"
      },
      {
        "id": "bird-28",
        "title": "共席",
        "text": "一席粗茶，也能談成心事；給關係留一個好好坐下的時辰。"
      },
      {
        "id": "bird-29",
        "title": "望山",
        "text": "山在遠處，路在腳前；記得抬頭，也記得看路。"
      },
      {
        "id": "bird-30",
        "title": "收帆",
        "text": "今日可以收工了；歇一歇，為明日留力。"
      },
      {
        "id": "bird-31",
        "title": "重逢",
        "text": "人事有改，心意可續；再見時，不必強求一切仍如從前。"
      },
      {
        "id": "bird-32",
        "title": "自定",
        "text": "卦箋只送一席話，路由你自己選；願你選得坦然，走得安穩。"
      }
    ]
  },
  "tarot": {
    "title": "塔羅",
    "subtitle": "翻開過去、現在與未來",
    "intro": "想好一個問題，先洗牌，再依次抽出三張。牌位由左至右，正逆各有一解。",
    "note": "偉特系大阿爾克那二十二張。使用現代三張時間牌陣，未來牌表示可思考的方向。",
    "positions": [
      "過去",
      "現在",
      "未來"
    ],
    "cards": [
      {
        "id": "tarot-00",
        "name": "愚者",
        "upright": "新的旅程要有好奇，也要帶著準備。",
        "reversed": "衝動走在判斷之前，先確認腳下是否穩妥。"
      },
      {
        "id": "tarot-01",
        "name": "魔術師",
        "upright": "手邊的工具已足，專心把想法化成行動。",
        "reversed": "才華分散，或承諾太滿；先完成一件小事。"
      },
      {
        "id": "tarot-02",
        "name": "女祭司",
        "upright": "靜下心聽直覺，尚未說出的訊息仍值得等候。",
        "reversed": "心聲被雜音蓋住，先分清祕密與猜測。"
      },
      {
        "id": "tarot-03",
        "name": "皇后",
        "upright": "照料生活與關係，讓創意有生長的土壤。",
        "reversed": "付出太多而忽略自己，照顧也需要界線。"
      },
      {
        "id": "tarot-04",
        "name": "皇帝",
        "upright": "訂好規矩與責任，穩定會替你留住成果。",
        "reversed": "控制太緊或缺少秩序，重談可以遵守的規則。"
      },
      {
        "id": "tarot-05",
        "name": "教皇",
        "upright": "向有經驗的人請教，傳統提供可參照的路徑。",
        "reversed": "既有規矩未必合用，辨明信念再決定是否跟隨。"
      },
      {
        "id": "tarot-06",
        "name": "戀人",
        "upright": "關係與選擇相連，讓行動與價值一致。",
        "reversed": "心意分歧，先說清楚各自真正重視的事。"
      },
      {
        "id": "tarot-07",
        "name": "戰車",
        "upright": "掌握方向，把相反的力量帶往同一個目標。",
        "reversed": "步調失衡，先穩住方向再加快腳步。"
      },
      {
        "id": "tarot-08",
        "name": "力量",
        "upright": "溫柔與耐性，也能安定強烈的情緒。",
        "reversed": "對自己太苛刻，先恢復信心與休息。"
      },
      {
        "id": "tarot-09",
        "name": "隱者",
        "upright": "獨處整理思緒，讓經驗成為照路的燈。",
        "reversed": "獨處變成封閉，試著向可信任的人開口。"
      },
      {
        "id": "tarot-10",
        "name": "命運之輪",
        "upright": "局勢正在轉動，留意可以掌握的機會。",
        "reversed": "變動暫受阻，不妨調整期待與步調。"
      },
      {
        "id": "tarot-11",
        "name": "正義",
        "upright": "依事實衡量，承擔選擇帶來的責任。",
        "reversed": "資訊或衡量有所偏斜，重新核對再下判斷。"
      },
      {
        "id": "tarot-12",
        "name": "吊人",
        "upright": "暫停也是選擇，換個角度便能看見新意。",
        "reversed": "等待若沒有方向，便該重新思量付出的代價。"
      },
      {
        "id": "tarot-13",
        "name": "死神",
        "upright": "一段階段將盡，替改變騰出空間。",
        "reversed": "執著於舊局，試著從一個小小的告別開始。"
      },
      {
        "id": "tarot-14",
        "name": "節制",
        "upright": "把不同的需求調和，找到能長久維持的節奏。",
        "reversed": "用力失衡，先減少一端的過量付出。"
      },
      {
        "id": "tarot-15",
        "name": "惡魔",
        "upright": "看清依賴與束縛，才有機會重新選擇。",
        "reversed": "鬆開束縛的機會已近，請承認真正想改變的事。"
      },
      {
        "id": "tarot-16",
        "name": "高塔",
        "upright": "舊有架構受震動，重建要從真實處開始。",
        "reversed": "明知基礎不穩卻遲遲不改，先面對一處裂縫。"
      },
      {
        "id": "tarot-17",
        "name": "星星",
        "upright": "恢復希望，讓小而穩定的照料帶你向前。",
        "reversed": "信心暫弱，先找回一件仍值得期待的事。"
      },
      {
        "id": "tarot-18",
        "name": "月亮",
        "upright": "迷霧中不急著下結論，感受與事實要分開看。",
        "reversed": "疑惑逐漸可辨，確認清楚再讓想像退場。"
      },
      {
        "id": "tarot-19",
        "name": "太陽",
        "upright": "把成果與喜悅分享，坦率會帶來明朗的回應。",
        "reversed": "快樂暫被遮住，別因一點延遲否定已有的進展。"
      },
      {
        "id": "tarot-20",
        "name": "審判",
        "upright": "回顧走過的路，回應心中再次響起的召喚。",
        "reversed": "自責或遲疑拖住腳步，允許自己重新回答。"
      },
      {
        "id": "tarot-21",
        "name": "世界",
        "upright": "一段旅程完成，把經驗收好，再迎接下一程。",
        "reversed": "收尾尚欠一步，先補齊再開始新的計畫。"
      }
    ]
  },
  "zodiac": {
    "title": "星座",
    "subtitle": "把生日寫在星圖上",
    "intro": "選你的出生月日，看看太陽星座的性情。",
    "note": "採常見熱帶黃道日期表。只憑月日是近似判定；交界日的精確星座須加出生年、時間與時區排盤。",
    "signs": [
      {
        "id": "aquarius",
        "name": "水瓶座",
        "start": 120,
        "text": "珍惜自己的想法，也替別人的新觀點留一把椅子。"
      },
      {
        "id": "pisces",
        "name": "雙魚座",
        "start": 219,
        "text": "感受豐富是你的禮物，清楚的界線讓溫柔走得更遠。"
      },
      {
        "id": "aries",
        "name": "牡羊座",
        "start": 321,
        "text": "勇氣替你開門，耐性幫你走完門後的路。"
      },
      {
        "id": "taurus",
        "name": "金牛座",
        "start": 420,
        "text": "穩定的步調能養成成果，也試著給改變一點餘地。"
      },
      {
        "id": "gemini",
        "name": "雙子座",
        "start": 521,
        "text": "好奇會牽來許多線索，挑一條深入，會有新的收穫。"
      },
      {
        "id": "cancer",
        "name": "巨蟹座",
        "start": 622,
        "text": "你在意的牽掛值得照料，自己的需要也值得被聽見。"
      },
      {
        "id": "leo",
        "name": "獅子座",
        "start": 723,
        "text": "讓熱情照亮自己，也照亮願意同行的人。"
      },
      {
        "id": "virgo",
        "name": "處女座",
        "start": 823,
        "text": "細心能修好許多細節，完成比一味追求完美更可貴。"
      },
      {
        "id": "libra",
        "name": "天秤座",
        "start": 923,
        "text": "體貼他人之外，也請把自己的選擇說清楚。"
      },
      {
        "id": "scorpio",
        "name": "天蠍座",
        "start": 1023,
        "text": "深刻的心意需要信任，把猜測換成一次坦白的交談。"
      },
      {
        "id": "sagittarius",
        "name": "射手座",
        "start": 1122,
        "text": "遠方很美，先把眼前的約定照顧好，出發便更自在。"
      },
      {
        "id": "capricorn",
        "name": "摩羯座",
        "start": 1222,
        "text": "長久的目標值得努力，也記得替今天留一點輕鬆。"
      }
    ]
  },
  "face": {
    "title": "相面",
    "subtitle": "正冠端坐，借鏡觀己",
    "intro": "不必開鏡頭。自選眉、眼、鼻、口、耳的形貌，聽相者一席話。",
    "note": "《潛夫論》只核到形貌、骨法、氣色與德行的總論。以下五官細項出處未核實，為遊戲擬寫，不能稱為漢代相書定法。",
    "closing": "相不獨在形，亦當觀行。君慎言修身，勿以一相自限。",
    "features": {
      "brow": {
        "label": "眉",
        "options": [
          {
            "id": "brow-0",
            "label": "疏朗",
            "text": "眉勢疏朗，宜從容議事，勿以急言傷和。"
          },
          {
            "id": "brow-1",
            "label": "濃密",
            "text": "眉勢濃密，宜持志有恆，亦當容人之異。"
          }
        ]
      },
      "eye": {
        "label": "眼",
        "options": [
          {
            "id": "eye-0",
            "label": "細長",
            "text": "目形細長，宜審其端緒，而後有所行。"
          },
          {
            "id": "eye-1",
            "label": "圓潤",
